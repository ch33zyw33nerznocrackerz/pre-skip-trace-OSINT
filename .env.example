# Copy to .env in this folder — loaded automatically on startup.

# --- Docker stack (recommended) ---
# docker compose -f docker/docker-compose.yml up -d
# docker compose -f docker/docker-compose.yml --profile tools up -d foss
# docker compose -f docker/docker-compose.yml --profile ui up -d spiderfoot-web  # optional web UI :5001

# Host port when 8080 is already taken — keep PORT, URL, and BASE_URL in sync:
#   just searxng-port 8081
SEARXNG_URL=http://127.0.0.1:8080
SEARXNG_PORT=8080
SEARXNG_BASE_URL=http://127.0.0.1:8080/

# Run SpiderFoot / Photon via Docker instead of local clones
FOSS_DOCKER=1
DOCKER_COMPOSE_FILE=docker/docker-compose.yml
FOSS_DOCKER_SERVICE=foss
# Faster Docker builds (BuildKit layer cache)
DOCKER_BUILDKIT=1
COMPOSE_DOCKER_CLI_BUILD=1
SPIDERFOOT_PORT=5001

# FOSS tool install directories (local clones — used when FOSS_DOCKER is unset)
# SPIDERFOOT_DIR=C:/tools/spiderfoot
# PHOTON_DIR=C:/tools/Photon

# --- Discovery APIs (optional keys) ---

# serper.dev — ~2,500 free Google search queries
SERPER_API_KEY=

# tavily.com — agent-oriented search API (free tier)
TAVILY_API_KEY=

# exa.ai — neural / semantic search (free tier)
EXA_API_KEY=

# Brave Search API — free tier at api.search.brave.com
BRAVE_API_KEY=

# linkup.so — deep web search API
LINKUP_API_KEY=

# firecrawl.dev — search/scrape free tier
FIRECRAWL_API_KEY=

# jina.ai — optional; higher rate limits for page text extraction (r.jina.ai)
JINA_API_KEY=

# DuckDuckGo — no key required (always-on search fallback)

# projectdiscovery chaos — passive subdomain dataset for subfinder (optional)
# https://chaos.projectdiscovery.io/
CHAOS_API_KEY=

# --- Collector API tokens (optional) ---

# courtlistener.com — enriches court collector with API docket hits
COURTLISTENER_API_TOKEN=

# opencorporates.com — enriches opencorp collector with API company hits
OPENCORPORATES_API_TOKEN=

# SEC EDGAR User-Agent contact — https://www.sec.gov/os/webmaster-faq
SEC_CONTACT_EMAIL=research@example.com
